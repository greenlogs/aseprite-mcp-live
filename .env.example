# 使用者自行安装的 Aseprite；环境变量优先于 .env。
ASEPRITE_PATH=C:/path/to/Aseprite.exe
# core（默认）：9 个实时核心入口，无连接时返回明确错误。
# cli：115 个上游兼容工具 + cli_execute；all：二者合并。
ASEPRITE_MCP_TOOL_PROFILE=core
# 原始 Lua 仅在显式启用 CLI 时额外开放。
ASEPRITE_MCP_ENABLE_RAW_LUA=0
# 实时监听默认固定端口；命令行 --host/--port 优先于环境变量。
ASEPRITE_MCP_HOST=127.0.0.1
ASEPRITE_MCP_PORT=8765
ASEPRITE_MCP_MAX_MESSAGE_BYTES=8388608
ASEPRITE_MCP_MAX_OPERATIONS=256
ASEPRITE_MCP_MAX_PIXELS=262144
ASEPRITE_MCP_MAX_PNG_BYTES=4194304
ASEPRITE_MCP_TIMEOUT_SECONDS=30
ASEPRITE_MCP_MAX_BATCH_SECONDS=0.25
ASEPRITE_MCP_DEDUP_ENTRIES=256
ASEPRITE_MCP_DEDUP_TTL_SECONDS=120

# 可选：自动发现的私有目录。两侧需使用相同目录；通常无需配置。
# ASEPRITE_MCP_RUNTIME_DIR=C:/private/aseprite-mcp
# 兼容入口：显式发现文件须不存在；port=0 也仅用于手动 JSON 连接。
# ASEPRITE_MCP_CONNECTION_FILE=C:/private/connection.json
